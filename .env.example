# Atlas configuration (all values can also be set in the UI).
# Copy to .env if you use a dotenv loader; Atlas itself reads the process env.

# Storage
ATLAS_DATA_DIR=./data
ATLAS_MAX_UPLOAD_MB=128
ATLAS_MAX_ANALYSIS_ROWS=300000

# Query sandbox
ATLAS_QUERY_TIMEOUT=8
ATLAS_ROW_LIMIT=1000

# Optional model (none | openai | ollama)
ATLAS_LLM_PROVIDER=none
ATLAS_LLM_MODEL=
ATLAS_LLM_BASE_URL=
ATLAS_LLM_API_KEY=
ATLAS_LLM_TEMPERATURE=0.2
